#!/bin/bash
# /usr/bin/codrug — instalado pelo pacote .deb.
#
# Roda como o usuário comum que clicou no menu (não como root). Só faz duas
# coisas:
#   1) sincroniza o código instalado pelo pacote em /opt/codrug para
#      $HOME/CODRUG, sem nunca tocar em $HOME/CODRUG/PROJECTS (resultados do
#      usuário) nem em caches de bytecode;
#   2) delega tudo o mais — criação/atualização do venv em
#      $HOME/.venv/CODRUG, instalação das dependências científicas,
#      criação do .desktop em ~/.local/share/applications — para o próprio
#      CODRUG.py, que já faz isso sozinho na primeira execução (ver
#      BIN/module_requirements.py e BIN/splash_screen.py).
set -euo pipefail

SRC_DIR="/opt/codrug"
APP_DIR="${HOME}/CODRUG"

if [ ! -d "$SRC_DIR" ]; then
    echo "codrug: $SRC_DIR não encontrado — o pacote está corrompido ou foi removido." >&2
    exit 1
fi

mkdir -p "$APP_DIR"

if command -v rsync >/dev/null 2>&1; then
    rsync -a \
        --exclude='PROJECTS/' \
        --exclude='JOBS/' \
        --exclude='__pycache__/' \
        --exclude='*.pyc' \
        "$SRC_DIR"/ "$APP_DIR"/
else
    # Fallback sem rsync: copia tudo exceto as pastas de projetos do usuário
    # (PROJECTS e a antiga JOBS, migrada para PROJECTS pelo próprio CODRUG).
    for item in "$SRC_DIR"/*; do
        name="$(basename "$item")"
        { [ "$name" = "PROJECTS" ] || [ "$name" = "JOBS" ]; } && continue
        cp -rf "$item" "$APP_DIR"/
    done
fi

# O menu abre o CODRUG sem terminal (Terminal=false no .desktop; a saída do programa fica em
# Help > Terminal). Só a PRIMEIRA execução, que ainda precisa criar o venv e pode pedir
# confirmações/senha, é reaberta dentro de um emulador de terminal.
VENV_PY="${HOME}/.venv/CODRUG/bin/python"
if [ ! -x "$VENV_PY" ] && [ ! -t 0 ] && [ -z "${CODRUG_SETUP_TERMINAL:-}" ]; then
    export CODRUG_SETUP_TERMINAL=1
    SELF="$(readlink -f "$0")"
    if command -v gnome-terminal >/dev/null 2>&1; then
        exec gnome-terminal --title="CODRUG - Setup" -- "$SELF" "$@"
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        exec x-terminal-emulator -e "$SELF"
    elif command -v xterm >/dev/null 2>&1; then
        exec xterm -T "CODRUG - Setup" -e "$SELF" "$@"
    fi
fi

exec python3 "$APP_DIR/CODRUG.py" "$@"
